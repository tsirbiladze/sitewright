#!/usr/bin/env node
// A stand-in for the GitHub CLI during a rehearsal of the skill: "GitHub" is a folder of bare
// repositories under REHEARSAL_HOME/github, so a push really pushes and nothing leaves the machine.
import { spawnSync } from 'node:child_process';
import { appendFileSync, existsSync, mkdirSync, readFileSync, writeFileSync } from 'node:fs';
import { basename, join, resolve } from 'node:path';

const home = process.env.REHEARSAL_HOME;
if (!home) { console.error('rehearsal: REHEARSAL_HOME is not set'); process.exit(1); }
const args = process.argv.slice(2);
appendFileSync(join(home, 'calls.log'), `gh ${args.join(' ')}\n`);
const stateFile = join(home, 'github-state.json');
const state = existsSync(stateFile) ? JSON.parse(readFileSync(stateFile, 'utf8')) : { user: 'rehearsal-owner', signedIn: true, repos: {} };
const save = () => writeFileSync(stateFile, JSON.stringify(state, null, 2));
const [a, b] = args;

if (a === 'auth' && b === 'status') {
  if (!state.signedIn) { console.error('You are not logged into any GitHub hosts. To log in, run: gh auth login'); process.exit(1); }
  console.log(`github.com\n  ✓ Logged in to github.com account ${state.user} (keyring)\n  - Active account: true\n  - Git operations protocol: https`);
  process.exit(0);
}
if (a === 'auth' && b === 'login') { state.signedIn = true; save(); console.log(`✓ Logged in as ${state.user} (rehearsal: nobody signed in to anything)`); process.exit(0); }

if (a === 'repo' && b === 'create') {
  if (!state.signedIn) { console.error('To get started with GitHub CLI, please run:  gh auth login'); process.exit(4); }
  const rest = args.slice(2);
  const flag = (name) => { const i = rest.indexOf(name); return i === -1 ? undefined : rest[i + 1]; };
  const has = (name) => rest.includes(name);
  const source = flag('--source') ?? flag('-s');
  const named = rest.find((x, i) => !x.startsWith('-') && !['--source', '-s', '--remote', '-r', '--description', '-d', '--homepage', '-h'].includes(rest[i - 1]));
  const visibility = ['--private', '--public', '--internal'].find(has);
  if (!visibility) { console.error('`--public`, `--private`, or `--internal` required when not running interactively'); process.exit(1); }
  const name = (named ?? (source ? basename(resolve(source)) : '')).replace(/^.*\//, '');
  if (!name) { console.error('name argument required to create new remote repository'); process.exit(1); }
  if (state.repos[name]) { console.error(`GraphQL: Name already exists on this account (createRepository)`); process.exit(1); }
  const bare = join(home, 'github', `${name}.git`);
  mkdirSync(join(home, 'github'), { recursive: true });
  spawnSync('git', ['init', '--bare', '-b', 'main', bare], { stdio: 'ignore' });
  state.repos[name] = { visibility: visibility.slice(2), path: bare };
  save();
  console.log(`✓ Created repository ${state.user}/${name} on GitHub\n  https://github.com/${state.user}/${name}`);
  if (source) {
    const remote = flag('--remote') ?? flag('-r') ?? 'origin';
    const git = (...g) => spawnSync('git', ['-C', resolve(source), ...g], { encoding: 'utf8' });
    const added = git('remote', 'add', remote, bare);
    if (added.status !== 0) { process.stderr.write(added.stderr); process.exit(1); }
    console.log(`✓ Added remote ${bare}`);
    if (has('--push')) {
      const pushed = git('push', '-u', remote, 'HEAD');
      if (pushed.status !== 0) { process.stderr.write(pushed.stderr); process.exit(1); }
      console.log(`✓ Pushed commits to ${bare}`);
    }
  }
  process.exit(0);
}

console.error(`rehearsal: the stand-in has no answer for "gh ${args.join(' ')}"`);
process.exit(1);
